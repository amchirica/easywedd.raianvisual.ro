/**
 * Cloudflare Workers config for OpenNext.
 * Worker name MUST match Dashboard + WORKER_SELF_REFERENCE.service.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easywedd-raianvisual",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-30",
  // Required for OpenNext / Node APIs. Explicitly populate process.env from
  // Worker secrets & vars (also default after 2025-04-01 with nodejs_compat).
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Required by OpenNext for ISR / cache revalidation.
      // Must equal wrangler "name" exactly.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "easywedd-raianvisual"
    }
  ],
  // Required to stay under Workers Free gzip limit (3 MiB).
  "minify": true,
  "observability": {
    "enabled": true
  }
}
