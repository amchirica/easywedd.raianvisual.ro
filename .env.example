# =============================================================================
# Local development (.env.local) — copy this file
# Production secrets go in Cloudflare Worker Variables (NOT here). See docs/ENV.md
# =============================================================================

# App URL — use ONE canonical value locally. Prefer SITE_URL.
# Do not set conflicting production vs localhost values in the same file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional alias (same value as SITE_URL if set):
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Product IDs (prod_…) — catalog only, NEVER used in Checkout
STRIPE_PRODUCT_STARTER_MONTHLY=
STRIPE_PRODUCT_PREMIUM_PASS_12=
STRIPE_PRODUCT_PREMIUM_PASS_18=
STRIPE_PRODUCT_PRO_MONTHLY=
# Price IDs (price_…) — REQUIRED for Checkout line_items[].price
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PREMIUM_PASS_12=
STRIPE_PRICE_PREMIUM_PASS_18=
STRIPE_PRICE_PRO_MONTHLY=

# Resend (optional — partner invites / transactional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@easywedd.raianvisual.ro
RESEND_FROM_NAME=EasyWedd
