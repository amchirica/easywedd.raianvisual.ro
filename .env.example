# App — prefer NEXT_PUBLIC_SITE_URL (NEXT_PUBLIC_APP_URL remains supported)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (optional in stage 1 — payments not activated)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (partner invites / app transactional mail — not Supabase auth confirmation)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@easywedd.raianvisual.ro
RESEND_FROM_NAME=EasyWedd
